{
  "name": "xcortex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "serve:legacy": "node scripts/serve-legacy.mjs",
    "test:baseline": "playwright test --project=legacy --update-snapshots",
    "test:parity": "playwright test --project=next",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lhci": "lhci collect && lhci assert"
  },
  "dependencies": {
    "@iconify-json/solar": "1.2.16",
    "@iconify/utils": "3.1.7",
    "@vercel/analytics": "2.0.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
